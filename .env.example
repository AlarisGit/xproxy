# Скопируйте этот файл в .env и заполните значения.
# Формат: KEY=VALUE. Комментарии начинаются с '#', пустые строки игнорируются.
# Значения можно оборачивать в "..." или '...', кавычки снимаются.
# Файл .env в .gitignore — хранить секреты в нём безопасно.

# UUID подписки от VPN-провайдера (ранее хранился в .id).
SUBSCR_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Telegram-уведомления (опционально).
# Получить токен: https://t.me/BotFather → /newbot.
# Узнать свой chat_id: напишите боту, затем откройте
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Если любое из двух значений пустое — уведомления не отправляются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_USER_ID=
