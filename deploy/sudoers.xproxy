# /etc/sudoers.d/xproxy  (chmod 0440)
# Разрешает xproxy-демону рестартить xray и переписывать его config.json
# без пароля. Замените __USER__ на своего пользователя.

Cmnd_Alias XPROXY_CMDS = \
    /bin/systemctl restart xray, \
    /usr/bin/systemctl restart xray, \
    /bin/systemctl reset-failed xray, \
    /usr/bin/systemctl reset-failed xray, \
    /usr/bin/tee /usr/local/etc/xray/.config.json.xproxy.*.tmp, \
    /bin/tee /usr/local/etc/xray/.config.json.xproxy.*.tmp, \
    /bin/chmod 0644 /usr/local/etc/xray/.config.json.xproxy.*.tmp, \
    /usr/bin/chmod 0644 /usr/local/etc/xray/.config.json.xproxy.*.tmp, \
    /bin/mv -f /usr/local/etc/xray/.config.json.xproxy.*.tmp /usr/local/etc/xray/config.json, \
    /usr/bin/mv -f /usr/local/etc/xray/.config.json.xproxy.*.tmp /usr/local/etc/xray/config.json

__USER__ ALL=(root) NOPASSWD: XPROXY_CMDS
Defaults!XPROXY_CMDS !requiretty

# Примечание: geo-файлы (geosite.dat, geoip.dat) в системный /usr/local/share/xray
# демон НЕ пишет — они лежат в /var/lib/xproxy/geo (на Linux) и xray читает их
# через XRAY_LOCATION_ASSET (см. deploy/install.sh, xray drop-in xproxy-geo.conf).
